# cert-manager 账号凭证
# 复制为 config/.env 后填写（.env 已在 .gitignore 中，不要提交）。
#
# 命名规则：<账号名>_AK / <账号名>_SK，账号名即 certs.yaml 里的 dns_account / deploy_account。
#   - 直接写 CN1_AK/CN1_SK  -> 账号 cn1
#   - 也可写 ALIYUN_CN1_AK/ALIYUN_CN1_SK -> 同样映射成账号 cn1（ALIYUN_ 只是可选标记，
#     便于一眼看出是阿里云账号；证书配置里仍写 deploy_account: cn1，不用带 ALIYUN_）
# 账号的 REGION 也跟着账号写在 .env（见下方 CN1_REGION/INTL1_REGION），certs.yaml 里不再写 accounts。
# <账号名>_ENDPOINT 可选；服务器 crontab 内联的同名变量优先级高于本文件。
# 注意：若用 ALIYUN_ 前缀，SK/REGION 也要用同样的前缀（ALIYUN_CN1_SK 等）。

# ===== 国内站（cn*）=====
# cn1
CN1_AK=LTAIxxxxxxxxxxxxxxxx
CN1_SK=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CN1_REGION=cn-hangzhou
# CN1_ENDPOINT=

# cn2
CN2_AK=LTAIzzzzzzzzzzzzzzzz
CN2_SK=zzzzzzzzzzzzzzzzzzzzzzzzzzzz
CN2_REGION=cn-hangzhou

# 带 ALIYUN_ 标记的写法示例（与上面二选一，不要同时给 cn1 配两组）：
# ALIYUN_CN1_AK=LTAIxxxxxxxxxxxxxxxx
# ALIYUN_CN1_SK=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ALIYUN_CN1_REGION=cn-hangzhou

# ===== 国际站（intl*）=====
# intl1
INTL1_AK=LTAIyyyyyyyyyyyyyyyy
INTL1_SK=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
INTL1_REGION=ap-southeast-1
# INTL1_ENDPOINT=ap-southeast-1.aliyuncs.com

# ---- WAF 3.0（仅当配置了 waf_domains 时需要）----
# 国内站 / 国际站是不同的阿里云账号、不同的 WAF 实例，按账号分别配：
#   <账号名大写>_WAF_INSTANCE_ID  如 CN1_WAF_INSTANCE_ID / INTL1_WAF_INSTANCE_ID
#   <账号名大写>_WAF_REGION       可选，默认用该账号的 REGION
# 不知道填哪个时，先留空，运行 `python3 certmgr.py --config config/certs.yaml --list-waf-instances`
# 会按账号调接口列出各自 WAF 实例详情（InstanceId/地域/状态/到期），再按结果填对应账号的变量。
# 账号下只有一个正常实例时脚本会自动选用；多个实例必须显式写对应账号的 _WAF_INSTANCE_ID。

# 国内站 WAF（账号 cn1）
CN1_WAF_INSTANCE_ID=
# CN1_WAF_REGION=cn-hangzhou

# 国际站 WAF（账号 intl1）
INTL1_WAF_INSTANCE_ID=
# INTL1_WAF_REGION=ap-southeast-1

# 全局兜底：所有账号共用同一个 WAF 实例时才用；优先级低于上面的账号级配置
# WAF_INSTANCE_ID=
# WAF_REGION=cn-hangzhou

# ---- Cloudflare（仅当证书 dns=cloudflare 时需要）----
# certs.yaml 的 cloudflare 段用 ${CF_TOKEN_1} 引用
CF_TOKEN_1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_ACCOUNT_ID_1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CF_EMAIL_1=
