# cert-manager 变量值（复制为 config/.env 后填写，已被 gitignore 忽略）。
# 这里只放扁平的 key=value；账号的层级结构写在 certs.yaml，用 ${VAR} 引用这里的值。
# crontab 内联的同名环境变量优先级高于本文件。

# ===== 阿里云账号变量（对应 certs.yaml 的 accounts 段 ${CN1_AK} 等）=====
# 国内站 cn1
CN1_AK=LTAIxxxxxxxxxxxxxxxx
CN1_SK=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 国际站 intl1
INTL1_AK=LTAIyyyyyyyyyyyyyyyy
INTL1_SK=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# 注：region 写在 certs.yaml 的 accounts 段（cn-hangzhou / ap-southeast-1），不在这里

# ===== Cloudflare 变量（对应 certs.yaml 的 cloudflare 段 ${CF_TOKEN_1}）=====
CF_TOKEN_1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_ACCOUNT_ID_1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CF_EMAIL_1=you@example.com

# ===== WAF 3.0 实例 ID（扁平值，按账号分别配；用 --list-waf-instances 查看）=====
# 国内站 WAF（账号 cn1）
CN1_WAF_INSTANCE_ID=
# CN1_WAF_REGION=cn-hangzhou

# 国际站 WAF（账号 intl1）
INTL1_WAF_INSTANCE_ID=
# INTL1_WAF_REGION=ap-southeast-1

# 所有账号共用一个实例时才用全局兜底（优先级低于账号级）
# WAF_INSTANCE_ID=
# WAF_REGION=cn-hangzhou
